# ================================================================
# Local development environment template
# Copy to .env, or run scripts/initialize-local-env.ps1.
# .env is ignored by Git. Existing parameter names are preserved.
# ================================================================

# [1] Application and database
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=im_user
DB_PASSWORD=change-me
DB_DATABASE=im_server
# Legacy aliases retained for existing local configuration compatibility.
DB_USER=
DB_NAME=

# [1.1] Audit log storage (common-audit-service, plan docs/renovation/AUDIT_STORAGE_01_SERVICE.md)
# The audit table lives in its own schema. Switching is done by the `audit-schema` profile
# (it flips both the database and the Flyway migration directory in one atomic step):
#   unset profile -> open_saas + classpath:db/migration        (legacy history, ordinary table)
#   audit-schema  -> open_audit + classpath:db/migration-audit (partitioned table + ledger + manifest)
# Run the schema bootstrap BEFORE enabling it. Local Kind (k8s/local) needs no manual step:
# its mysql-saas-init Job already creates open_audit and grants it. For ACK, run
# scripts/migration/audit-schema-bootstrap.sql once with __DB_USERNAME__ replaced by im_user.
# AUDIT_DATABASE=open_audit
# SPRING_PROFILES_ACTIVE=audit-schema
# Audit retention job (defaults shown; the job is idempotent and safe to re-run).
# AUDIT_RETENTION_ENABLED=true
# AUDIT_RETENTION_HOT_MONTHS=24
# AUDIT_RETENTION_PRE_CREATE_MONTHS=2
# AUDIT_RETENTION_IDEMPOTENCY_DAYS=7
# AUDIT_RETENTION_HOLD_PERIODS=2026-03
# The audit service also reports its own retention actions through AuditClient, so it needs its
# own report endpoint (otherwise its self-audit silently goes to localhost and is lost).
# INTERNAL_AUDIT_SERVICE_BASE_URL=http://localhost:4190

# [2] Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# [3] MongoDB
MONGODB_URI=
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=im_chat
MONGODB_USERNAME=im_chat_app
MONGODB_PASSWORD=change-me
MONGODB_AUTH_DATABASE=admin

# [4] RocketMQ
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_ACCESS_KEY=change-me
ROCKETMQ_SECRET_KEY=change-me
IM_MQ_PRODUCER_GROUP=
IM_MQ_CONSUMER_GROUP_PREFIX=

# [5] Push notifications (JPush)
JPUSH_ENABLED=false
JPUSH_ENDPOINT=https://api.jpush.cn/v3/push
JPUSH_APP_KEY=change-me
JPUSH_MASTER_SECRET=change-me
JPUSH_APNS_PRODUCTION=false
JPUSH_TIME_TO_LIVE_SECONDS=86400

# [6] Authentication and service-to-service security
JWT_SECRET=change-me
JWT_EXPIRATION_MS=604800000
INTERNAL_SERVICE_AUTH_SECRET=change-me

# [7] Internal service endpoints
INTERNAL_USER_SERVICE_BASE_URL=http://127.0.0.1:3100
INTERNAL_MESSAGE_SERVICE_BASE_URL=http://127.0.0.1:3200
INTERNAL_CONVERSATION_SERVICE_BASE_URL=http://127.0.0.1:3300
INTERNAL_ORDER_SERVICE_BASE_URL=http://127.0.0.1:3500
IM_USER_SERVICE_BASE_URL=http://127.0.0.1:3100
IM_CONVERSATION_SERVICE_BASE_URL=http://127.0.0.1:3300

# [7.1] WebRTC TURN relay
# Production credentials must be stored in a secret, never committed to this file.
IM_CONVERSATION_RTC_ENABLED=false
IM_CONVERSATION_RTC_TURN_URL=turn:turn.dev.example.com:3478?transport=udp,turn:turn.dev.example.com:3478?transport=tcp
IM_CONVERSATION_RTC_TURN_USERNAME=turnuser
IM_CONVERSATION_RTC_TURN_PASSWORD=change-me

# [8] Gateway and documentation
IM_ACCESS_WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
IM_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
IM_DOCUMENTATION_USERNAME=docs-admin
IM_DOCUMENTATION_PASSWORD=change-me

# [9] Added local media storage: Docker MinIO
# Inside Compose, the service endpoint is http://minio:9000.
# Set MEDIA_PUBLIC_BASE_URL to a LAN-reachable host for physical devices.
IM_DEPLOY_ENV=local
MEDIA_PROVIDER=minio
MEDIA_INTERNAL_ENDPOINT=http://minio:9000
MEDIA_REGION=us-east-1
MEDIA_PRIVATE_BUCKET=open-im-local-private
MEDIA_PUBLIC_BASE_URL=http://192.168.1.100:9000
MEDIA_ACCESS_KEY=local-minio-access-key
MEDIA_SECRET_KEY=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=local-minio-access-key
MINIO_ROOT_PASSWORD=change-me

# [10] Added upload policy (bytes)
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_ATTACHMENT_BYTES=52428800
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_ALLOWED_ATTACHMENT_TYPES=application/pdf,text/plain,application/zip
MEDIA_ALLOWED_VIDEO_TYPES=video/mp4
MEDIA_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/ogg,audio/wav,audio/mp4,audio/aac
